{
  "name": "mock-idp",
  "image": "mcr.microsoft.com/devcontainers/python:3.14-bookworm",
  "features": {
    "ghcr.io/astral-sh/uv:latest": {}
  },
  "postCreateCommand": "uv sync && uv tool install pre-commit && pre-commit install",
  "postStartCommand": "uv run uvicorn mock_idp.main:app --host 0.0.0.0 --port 8080 > /tmp/mock-idp.log 2>&1 &",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "mock-idp",
      "onAutoForward": "notify"
    }
  },
  "remoteEnv": {
    "CONFIG_PATH": "config.example.yaml",
    "ISS_BASE": "http://localhost:8080"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "[python]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  }
}
